# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is listed in .gitignore and must never be committed.

# --- Mock shop -------------------------------------------------------------
# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SHOP_API_KEY=change-me

# Currency shown on the shop website (the demo supplier uses euros)
SHOP_CURRENCY=EUR

# --- Test page (http://localhost:8001/steuerung) ---------------------------
# Password testers enter to use the buttons. Empty = buttons disabled.
CONTROL_PASSWORD=
# Seconds between two clicks of the same button
CONTROL_COOLDOWN_SECONDS=60
# Where the shop finds n8n's webhooks (production URLs, workflows must be active)
N8N_WEBHOOK_BASE=http://host.docker.internal:5678/webhook
# Link to your Google Sheet (for the "Google Sheet öffnen" button)
SHEET_URL=
# Link to the supplier website, as the tester's browser sees it
SUPPLIER_PUBLIC_URL=http://localhost:8003
# ElevenLabs agent id (not a secret)
VOICE_AGENT_ID=

# --- Scraper -----------------------------------------------------------------
# Default source: supplier (our demo supplier website) or shopify
SCRAPER_SOURCE=supplier
# Where the supplier website is: http://supplier (local container)
# or your Netlify address, e.g. https://nordholm-demo.netlify.app
SUPPLIER_BASE_URL=http://supplier
# Optional Shopify source (only used with source=shopify):
# the store address and a collection (a handle or a full collection link).
# Only scrape stores whose terms and robots.txt allow it.
SHOPIFY_STORE_URL=
SHOPIFY_COLLECTION=
# Pause between requests in seconds (be polite to the website)
SCRAPER_DELAY_SECONDS=2
# Max. images downloaded per product
SCRAPER_MAX_IMAGES=4
